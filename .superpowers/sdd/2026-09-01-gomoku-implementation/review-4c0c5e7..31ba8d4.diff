+    fn random_empty_cell(b: &Board, rng: &mut Xorshift64) -> Option<Idx> {
+        let mut empties = Vec::new();
+        for y in 0..SIZE {
+            for x in 0..SIZE {
+                let i = idx(x, y);
+                if b.get(i) == Cell::Empty {
+                    empties.push(i);
+                }
+            }
+        }
+        if empties.is_empty() {
+            return None;
+        }
+        let pick = (rng.next() as usize) % empties.len();
+        empties.get(pick).copied()
+    }
